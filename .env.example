# Copied to .env by scripts/start_backend.sh on first run.
PRISM_PG_PORT=5434
PRISM_PG_ADMIN_PASSWORD=postgres
PRISM_PG_SVC_PASSWORD=prism_svc_dev
PRISM_NEO4J_HTTP_PORT=7475
PRISM_NEO4J_BOLT_PORT=7688
PRISM_NEO4J_PASSWORD=prism-dev-neo4j
# PRISM_CTX_HMAC_KEY, PRISM_JWT_SECRET and PRISM_AUDIT_HMAC_KEY are generated into .env on first run.
# ANTHROPIC_API_KEY=            # only needed for real /chat answers (live smoke tests use the scripted model)
# PRISM_HISTORY_MIN_CALLERS=2   # distinct callers before a recorded question becomes a history example (1 for a
#                               # single-user demo)

# PRISM_AGENT_DEV_TOKEN_ENABLED=true   # local demo only: lets the UI/curl mint persona tokens at POST /dev/token (loopback clients only); scripts/start_backend.sh defaults it to true, set false here to turn it off
